# 依赖与构建产物：target 有 31 GB，误 add 一次就废掉整个仓库
node_modules/
dist/
src-tauri/target/

# tauri-build 每次编译重写的权限清单，进来只是噪音
src-tauri/gen/schemas/

# agent 在本机留下的运行时配置，不属于源码
.agent-kernel/

# 本机跑出来的日志
*.log

# 没有版本控制时代留下的回退手段，只在本机保命，不进仓库
.removed-*/
.icons-backup-*/
.archive/

# 小红书配图的本机产物和渲染脚本，不是源码
.xhs/

# 截图时留下的本机脚本和真库备份，含个人信息，绝不进仓库
.shots/
